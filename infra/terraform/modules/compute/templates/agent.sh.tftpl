#!/bin/bash
set -euxo pipefail

apt-get update -y
apt-get install -y curl

until curl -kfsS \
  "https://${server_private_ip}:6443/ping" >/dev/null 2>&1
do
  sleep 10
done

curl -sfL https://get.k3s.io | \
  INSTALL_K3S_VERSION='${k3s_version}' \
  K3S_URL='https://${server_private_ip}:6443' \
  K3S_TOKEN='${k3s_token}' \
  sh -s - agent